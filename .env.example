# Add this secret in Vercel Environment Variables; do not commit it here.
# POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai/gpt-5.4-nano
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_VIDEO_MODEL=google/veo-3.1-fast
POLLINATIONS_MUSIC_MODEL=elevenlabs/music-v2.5

# Ollama provider for local development and optional hosted failover in production.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=llava:7b
POLLINATIONS_VISION_MODEL=openai/gpt-5.4-nano
# OLLAMA_API_KEY=

# Media generation providers. Each URL receives a POST with prompt and generation settings.
# VIDEO_GENERATION_URL=https://your-provider.example/v1/video/generate
# VIDEO_GENERATION_API_KEY=
# Music generation has no app-side request cap; the provider may still enforce quotas or charges.
# MUSIC_GENERATION_URL=https://your-provider.example/v1/music/generate
# MUSIC_GENERATION_API_KEY=
# THREE_D_GENERATION_URL=https://your-provider.example/v1/3d/generate
# THREE_D_GENERATION_API_KEY=

# Required in production for shared request limits.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
