# Add this secret in Vercel Environment Variables; do not commit it here.
# POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai/gpt-5.4-nano

# Local Ollama fallback when POLLINATIONS_API_KEY is not set.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Required in production for shared request limits.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
